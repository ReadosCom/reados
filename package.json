{
  "name": "reados",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check:biome": "biome check .",
    "check:ts": "tsc -b --pretty false",
    "test": "sh -c 'testing/run.sh'",
    "test:services": "sh -c 'testing/diagnose-services.sh'",
    "dc:migrate": "docker compose -f compose.yaml -f config/compose/migrate.compose.yaml run --rm migration",
    "dc:seed": "sh -c 'npm run dc:migrate && docker compose -f compose.yaml -f config/compose/seed.compose.yaml run --rm seed'",
    "dc:seed:silent": "sh -c 'npm run dc:migrate && docker compose -f compose.yaml -f config/compose/seed.compose.yaml run --rm -e SEED_NON_INTERACTIVE=true -e SEED_USE_DEFAULTS=true seed'",
    "lint": "eslint .",
    "migrate": "npm run run -- src/migration.server.ts",
    "seed": "npm run run -- src/seed.server.ts",
    "run": "tsx",
    "watch": "tsx watch --clear-screen=false",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@hugeicons/core-free-icons": "^4.1.1",
    "@hugeicons/react": "^1.1.6",
    "@js-temporal/polyfill": "^0.5.1",
    "@tanstack/react-query": "^5.100.5",
    "@tanstack/react-router": "^1.168.24",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dompurify": "^3.4.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "i18next": "^26.0.8",
    "input-otp": "^1.4.2",
    "nodemailer": "^8.0.7",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-error-boundary": "^6.1.1",
    "react-hook-form": "^7.74.0",
    "react-i18next": "^17.0.4",
    "shadcn": "^4.6.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.0",
    "zod": "^4.3.6",
    "zod-openapi": "^5.4.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@eslint/js": "^9.39.4",
    "@istanbuljs/esm-loader-hook": "^0.3.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-query-devtools": "^5.100.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.2",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "nyc": "^18.0.0",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vite-plugin-istanbul": "^8.0.0"
  }
}
